{
  "name": "TikTok HD Downloader",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "portsAttributes": {
    "8000": {
      "label": "TikTok Downloader App",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "forwardPorts": [8000]
}
